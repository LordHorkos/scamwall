# SPDX-License-Identifier: AGPL-3.0-only
#
# Copy to .env and adjust. The .env file is gitignored and must never be
# committed: it names site-specific addresses and paths.

# Address that the name "pi.hole" resolves to inside the container.
# "host-gateway" is the Docker bridge gateway (the host). Replace with an
# explicit LAN address to route over a specific interface instead.
#
# This changes RESOLUTION ONLY. TLS still requires a certificate valid for
# "pi.hole" chaining to the mounted private CA.
PIHOLE_HOST_IP=host-gateway

# Group id that owns /etc/scamwall/secrets/pihole_app_password.
# The container joins this group so a non-root process can read the secret
# without it ever becoming world-readable.
SCAMWALL_SECRET_GID=65532

# Paths on the host.
SCAMWALL_SECRET_FILE=/etc/scamwall/secrets/pihole_app_password
SCAMWALL_CONFIG=./config.example.json
SCAMWALL_FEED=../../testdata/feed.json

# Build metadata.
SCAMWALL_VERSION=dev
SCAMWALL_COMMIT=unknown
SCAMWALL_BUILD_DATE=unknown
